# Copy this file to .env and fill in real values. Never commit the real .env file.

# JWT signing secret. MUST be overridden with a long random value outside local dev.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_value

# Database connection. Defaults to local SQLite if unset.
# For Docker/production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql://personalverse:personalverse@db:5432/personalverse
DATABASE_URL=sqlite:///./personalverse.db

# AI provider keys (optional). Leave blank to use the built-in synthetic
# fallback responses. If multiple are set, priority is Anthropic > OpenAI > OpenRouter.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Comma-separated list of allowed frontend origins. "*" (default) allows any
# origin, which is fine for local dev but should be locked down in production.
CORS_ORIGINS=*
