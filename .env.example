# Used by `docker-compose.yml`. Copy to `.env` and fill in real values before
# running `docker compose up`. For local (non-Docker) development, use
# backend/.env instead (see backend/.env.example) — the frontend needs no
# env vars since it calls the API via a relative /api/v1 path.

SECRET_KEY=change_this_to_a_long_random_value
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
